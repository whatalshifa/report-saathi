# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
RS_DATABASE_URL=sqlite:///./reportsaathi.db
RS_UPLOAD_DIR=./uploads
RS_CLAUDE_EFFORT=medium

# Encrypts uploaded files. Leave empty in development (a key file is created for you).
# In production set it to 32 random bytes in base64, made with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing it means losing every uploaded file, so keep it in a secrets manager.
RS_MASTER_KEY=
# "production" turns on secure cookies and requires RS_MASTER_KEY.
RS_ENV=development

# Where uploaded files go: "local" (the folder above) or "s3" (any S3-compatible bucket).
# See docs/DEPLOY.md for the S3 settings.
RS_STORAGE=local
