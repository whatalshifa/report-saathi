# Copy this file to .env and fill in what you need. Never commit .env.
# Every setting below is read by app/config.py; the commented ones show their defaults.

# --- AI ---------------------------------------------------------------------
# Without a key the API runs in demo mode: reading new uploads is paused and visitors get the
# sample reports. Add a key from console.anthropic.com and uploads switch on.
ANTHROPIC_API_KEY=
# Which Claude model reads the reports, and how hard it thinks.
# RS_CLAUDE_MODEL=claude-opus-5-5
RS_CLAUDE_EFFORT=medium

# --- Database and files -----------------------------------------------------
# SQLite on your computer; a Postgres URL in production (postgres:// and postgresql:// both work).
RS_DATABASE_URL=sqlite:///./reportsaathi.db
# Where uploaded files go: "local" (the folder below) or "s3" (any S3-compatible bucket).
RS_STORAGE=local
RS_UPLOAD_DIR=./uploads
# RS_MAX_UPLOAD_MB=20
# With RS_STORAGE=s3 (see docs/DEPLOY.md). Leave the endpoint empty on AWS S3.
# RS_S3_BUCKET=
# RS_S3_ENDPOINT_URL=
# RS_S3_REGION=
# The bucket's keys, under the names every AWS tool uses. Not needed on AWS with an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Security ---------------------------------------------------------------
# "production" turns on secure cookies and requires RS_MASTER_KEY (or RS_KMS_KEY_ID).
RS_ENV=development
# Encrypts uploaded files. Leave empty in development (a key file is created for you at
# RS_MASTER_KEY_FILE). In production set it to 32 random bytes in base64, made with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing it means losing every uploaded file, so keep it in a secrets manager.
RS_MASTER_KEY=
# RS_MASTER_KEY_FILE=./.dev-master-key
# On AWS: a KMS key id or alias, so the master key never leaves KMS.
# RS_KMS_KEY_ID=
# The website's address, so browsers may call the API directly (a JSON list).
# RS_CORS_ORIGINS=["http://localhost:3000"]

# --- Accounts and limits ----------------------------------------------------
# RS_SESSION_DAYS=30
# RS_MAX_FAILED_LOGINS=5
# RS_LOCKOUT_MINUTES=15
# Demo accounts are deleted after this many hours, and can read only a few new reports.
# RS_GUEST_HOURS=24
# RS_GUEST_UPLOAD_LIMIT=3
# New reports any account can have read per day.
# RS_DAILY_UPLOAD_LIMIT=30
# How long a doctor's share link works.
# RS_SHARE_DAYS=7
# Requests allowed from one address per window (kept in memory, reset on restart).
# RS_DEMO_PER_IP_PER_HOUR=5
# RS_DEMO_PER_HOUR=100
# RS_AUTH_PER_IP_PER_10MIN=20
# RS_SHARED_PER_IP_PER_10MIN=60
# RS_EXPORT_PER_USER_PER_HOUR=5

# --- Running ----------------------------------------------------------------
# A Sentry project's DSN to have crashes reported (no report contents or cookies are sent).
# RS_SENTRY_DSN=
# Re-run reports a restart interrupted. Turn off when several copies of the API run at once.
# RS_RECOVER_JOBS_ON_START=true
